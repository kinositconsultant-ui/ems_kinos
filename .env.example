# Copy this file to .env and fill in the values intended for your deployment.
# Do not commit real secrets to the repository.

# Required Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# This value is *not* committed; edit .env (which is git-ignored).
SECRET_KEY=

# Required Fernet key for face-template encryption, used by
# attendance.services.face_encryption. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_TEMPLATE_ENCRYPTION_KEY=

# Optional OpenCV tuning values.
FACE_RECOGNITION_THRESHOLD=0.65
FACE_RECOGNITION_TOP_TWO_MARGIN=0.05
